/**
 * Customize default theme styling by overriding CSS variables:
 * https://github.com/vuejs/vitepress/blob/main/src/client/theme-default/styles/vars.css
 */
/**
 * Colors
 * -------------------------------------------------------------------------- */

// === Tsumiru "Indigo Night" — values are the SOURCE OF TRUTH from
//     theme-kit/themes/indigo.css. Do not invent new hexes; mirror that file. ===
$bg      = #0b0d1a   // --bg
$bg2     = #11142a   // --bg2 (elevated panels, sidebar, cards, code)
$ink     = #eef0fb   // --ink
$muted   = #9aa0c4   // --muted
$faint   = #6b7099   // --faint
$accent  = #7c7bff   // --accent (indigo)
$accent2 = #33d6ff   // --accent2 (cyan)
$brd     = rgba(255, 255, 255, 0.08)  // --panel-brd
$warning = #ffcf5c
$danger  = #ff6b6b
$info    = #2dd4bf

:root {
  // Brand accent (light mode + fallback)
  --vp-c-brand-1: $accent
  --vp-c-brand-2: lighten($accent, 8%)
  --vp-c-brand-3: $accent
  --vp-c-brand-soft: rgba(124, 123, 255, 0.14)
  // Legacy aliases still read by some components
  --vp-c-brand: $accent
  --vp-c-brand-light: lighten($accent, 10%)
  --vp-c-brand-lighter: lighten($accent, 20%)
  --vp-c-brand-lightest: lighten($accent, 30%)
  --vp-c-brand-dark: darken($accent, 10%)
  --vp-c-brand-darker: darken($accent, 20%)
  --vp-c-brand-dimm: rgba(124, 123, 255, 0.08)

  // Light surfaces, indigo-tinted (not plain grey)
  --vp-c-bg: #fbfbff
  --vp-c-bg-alt: #eef0fb
  --vp-c-bg-elv: #ffffff
  --vp-c-bg-soft: #f1f2fc

  // Buttons (light)
  --vp-button-brand-bg: $accent
  --vp-button-brand-hover-bg: lighten($accent, 8%)
  --vp-button-brand-active-bg: darken($accent, 8%)
  --vp-button-brand-border: transparent
  --vp-button-brand-hover-border: transparent
  --vp-button-brand-active-border: transparent
  --vp-button-brand-text: #ffffff
  --vp-button-brand-hover-text: #ffffff
  --vp-button-brand-active-text: #ffffff
}

// === Indigo Night (dark) — the default appearance ===

.dark {
  --vp-c-bg: $bg
  --vp-c-bg-alt: $bg2
  --vp-c-bg-elv: $bg2
  --vp-c-bg-soft: $bg2
  --vp-c-gutter: #05060f

  --vp-c-text-1: $ink
  --vp-c-text-2: $muted
  --vp-c-text-3: $faint

  --vp-c-divider: $brd
  --vp-c-border: $brd

  --vp-c-brand-1: $accent
  --vp-c-brand-2: lighten($accent, 10%)
  --vp-c-brand-3: $accent
  --vp-c-brand-soft: rgba(124, 123, 255, 0.16)

  // Buttons (dark): primary = solid accent, alt = glass panel w/ indigo hover
  --vp-button-brand-bg: $accent
  --vp-button-brand-hover-bg: lighten($accent, 8%)
  --vp-button-brand-active-bg: darken($accent, 8%)
  --vp-button-brand-border: transparent
  --vp-button-brand-hover-border: transparent
  --vp-button-brand-active-border: transparent
  --vp-button-brand-text: #ffffff
  --vp-button-brand-hover-text: #ffffff
  --vp-button-brand-active-text: #ffffff

  --vp-button-alt-bg: rgba(255, 255, 255, 0.05)
  --vp-button-alt-hover-bg: rgba(255, 255, 255, 0.1)
  --vp-button-alt-active-bg: rgba(255, 255, 255, 0.12)
  --vp-button-alt-border: $brd
  --vp-button-alt-hover-border: rgba(124, 123, 255, 0.5)
  --vp-button-alt-active-border: rgba(124, 123, 255, 0.6)
  --vp-button-alt-text: $ink
  --vp-button-alt-hover-text: $ink
  --vp-button-alt-active-text: $ink
}

// Rounded corners for content images inserted via HTML (our converted images)

.vp-doc img[loading="lazy"][decoding="async"] {
  border-radius: 12px
}

/**
 * Dark/Light Theme Overrides
 * -------------------------------------------------------------------------- */

html:not(.dark) {
  .only-dark,
  img[data-mode="darkmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="darkmode-only"]) {
    display: none !important
  }
}

.dark {
  .only-light,
  img[data-mode="lightmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="lightmode-only"]) {
    display: none !important
  }
}

/**
 * Component: Home
 * -------------------------------------------------------------------------- */

:root {
  --vp-home-hero-name-color: transparent
  --vp-home-hero-name-background: -webkit-linear-gradient(120deg, #7c7bff 30%, #33d6ff)
  --vp-home-hero-image-background-image: linear-gradient(-45deg, #7c7bff 50%, #33d6ff 50%)
  --vp-home-hero-image-filter: blur(40px)
}

.dark {
  --vp-home-hero-image-background-image: linear-gradient(-45deg, var(--vp-c-brand-darker) 25%, var(--vp-c-brand-darkest) 25%)
}

@media (min-width 640px) {
  :root {
    --vp-home-hero-image-filter: blur(56px)
  }
}

@media (min-width 960px) {
  :root {
    --vp-home-hero-image-filter: blur(72px)
  }
}

// Signature indigo→cyan gradient buttons (theme --grad: 135deg, #7c7bff → #33d6ff)

.VPButton.brand,
.download-button.primary {
  border: 0 !important
  color: #ffffff !important
  background: linear-gradient(135deg, #7c7bff, #33d6ff) !important
  transition: filter 0.25s ease, box-shadow 0.25s ease
}

.VPButton.brand:hover,
.download-button.primary:hover {
  filter: brightness(1.08)
  box-shadow: 0 4px 18px rgba(124, 123, 255, 0.45)
}

.VPFooter {
  .divider {
    color: var(--vp-c-divider)
  }
}

/**
 * Component: Custom Block
 * -------------------------------------------------------------------------- */

// Custom-block colors from theme-kit indigo.css semantic tokens
// (tip=accent indigo, warning=gold #ffcf5c, danger=#ff6b6b, info=#2dd4bf) — no muddy browns.

:root {
  --vp-custom-block-tip-border: $accent
  --vp-custom-block-tip-text: darken($accent, 12%)
  --vp-custom-block-tip-bg: rgba(124, 123, 255, 0.1)

  --vp-custom-block-warning-border: $warning
  --vp-custom-block-warning-text: darken($warning, 28%)
  --vp-custom-block-warning-bg: rgba(255, 207, 92, 0.12)

  --vp-custom-block-danger-border: $danger
  --vp-custom-block-danger-text: darken($danger, 18%)
  --vp-custom-block-danger-bg: rgba(255, 107, 107, 0.12)

  --vp-custom-block-info-border: $info
  --vp-custom-block-info-text: darken($info, 22%)
  --vp-custom-block-info-bg: rgba(45, 212, 191, 0.1)
}

.dark {
  --vp-custom-block-tip-border: $accent
  --vp-custom-block-tip-text: lighten($accent, 14%)
  --vp-custom-block-tip-bg: rgba(124, 123, 255, 0.12)

  --vp-custom-block-warning-border: $warning
  --vp-custom-block-warning-text: $warning
  --vp-custom-block-warning-bg: rgba(255, 207, 92, 0.12)

  --vp-custom-block-danger-border: $danger
  --vp-custom-block-danger-text: $danger
  --vp-custom-block-danger-bg: rgba(255, 107, 107, 0.12)

  --vp-custom-block-info-border: $info
  --vp-custom-block-info-text: $info
  --vp-custom-block-info-bg: rgba(45, 212, 191, 0.13)
}

.plugin-tabs {
  &--content {
    padding: 2rem !important
  }
}

/**
 * Component: Algolia
 * -------------------------------------------------------------------------- */

.DocSearch {
  --docsearch-primary-color: var(--vp-c-brand) !important
}

.VPImage.image-src {
  border-radius: 8px
}

/**
 * Component: LocalSearch
 */

.VPLocalSearchBox {
  --vp-local-search-highlight-bg: var(--vp-c-brand-soft)
  --vp-local-search-highlight-text: var(--vp-c-brand-dark)
}

.dark .VPLocalSearchBox {
  --vp-local-search-highlight-text: var(--vp-c-brand-lightest)
}

/**
 * Component: Image Figure
 * -------------------------------------------------------------------------- */

// Shitty method to give elevation to image - TO BE REPLACED

main figure {
  margin: 2rem 0
  transition: transform var(--vp-tt)

  img {
    margin: 0 auto
    border-radius: 12px
    box-shadow: 2px 2px 8px 4px var(--vp-c-bg-alt)

    &[alt="Translation progress"] {
      box-shadow: none !important
    }
  }

  figcaption {
    text-align: center
    margin-top: 1.25rem
    font-size: 0.875rem
    color: var(--vp-c-text-2)
  }

  & > a .external-link-icon {
    display: none
  }
}

main :where(h1, h2, h3, h4, h5, h6) + figure {
  margin-top: 1.5rem
}

.custom-block {
  figure figcaption {
    color: inherit
  }

  &.tip figure img {
    --vp-c-bg-alt: var(--vp-custom-block-tip-bg)
  }
}

/**
 * Component: Links
 * -------------------------------------------------------------------------- */

@media print {
  figure:has(img)>a[href^="http://"]:after,
  figure:has(img)>a[href^="https://"]:after {
    content: ""
  }
}

.vp-doc a {
  text-decoration: none

  &:hover {
    text-decoration: underline
    text-underline-offset: 2px
  }
}

/**
 * Component: Shortcodes
 * -------------------------------------------------------------------------- */

.navigation {
  color: var(--vp-c-green-2)
  font-weight: 600

  &:hover {
    color: var(--vp-c-green-1)
    cursor: default
  }

  svg,
  span.name {
    vertical-align: middle // Align both SVG and <span> vertically
    position: relative
    bottom: 1px
  }

  svg {
    fill: currentColor
    height: 1em
    width: 1em
    display: inline-block
    margin-right: 4px
  }
}

/**
 * Component: Element Plus
 */

body {
  --el-color-primary: var(--vp-c-brand-1)
}

/**
 * Component: Appearance Switch
 */

.menu + .appearance::before {
  margin-right: 8px !important
}

.appearance + .social-links::before {
  margin-left: 8px !important
}

.VPMenu .CustomSwitchAppearance {
  margin-right: -8px
}

/**
 * Component: Forks page
 */

.forks .VPFeatures {
  padding: 2rem 0 !important

  .VPLink:hover {
    text-decoration: none
  }

  .title {
    line-height: 24px
    font-size: 16px
    font-weight: 600
    margin: 0
    border-top: none
    padding-top: 0
    letter-spacing: 0
    color: var(--vp-c-text-1)
  }
}

@media (min-width 640px) {
  .forks .item.grid-4 {
    width: 50% !important
  }
}
