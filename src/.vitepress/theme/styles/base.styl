/**
 * Customize default theme styling by overriding CSS variables:
 * https://github.com/vuejs/vitepress/blob/main/src/client/theme-default/styles/vars.css
 */
/**
 * Colors
 * -------------------------------------------------------------------------- */

// === Tsumige "Royal". Dark values come from theme-kit/themes/royal.css,
//     light values from _royalLight in app/lib/src/utils/theme/theme_tokens.dart.
//     Do not invent new hexes; mirror those files. ===
$bg      = #0d0b16   // --bg
$bg2     = #16122a   // --bg2 (elevated panels, sidebar, cards, code)
$ink     = #f3eefb   // --ink
$muted   = #b6abd0   // --muted
$faint   = #7c719c   // --faint
$accent  = #e8c468   // --accent (gold)
$accent2 = #9b7bff   // --accent2 (violet)
$on-accent = #0a0a12
$brd     = rgba(255, 255, 255, 0.09)  // --panel-brd
$success = #4be3a0
$warning = #ffcf5c
$danger  = #ff6b6b

$l-bg      = #f1ebf9
$l-bg2     = #fffbff
$l-ink     = #1c1a26
$l-muted   = #605c6e
$l-faint   = #837f8f
$l-accent  = #5f45cc
$l-accent2 = #8a6400
$l-brd     = #dad5e3
$l-accent-bg = #e7e0ff
$l-grad-end  = #8e3fb8

:root {
  --vp-c-bg: $l-bg
  --vp-c-bg-alt: $l-bg2
  --vp-c-bg-elv: $l-bg2
  --vp-c-bg-soft: $l-bg2
  --vp-c-gutter: $l-brd

  --vp-c-text-1: $l-ink
  --vp-c-text-2: $l-muted
  --vp-c-text-3: $l-faint

  --vp-c-divider: $l-brd
  --vp-c-border: $l-brd

  // Brand accent (light mode + fallback)
  --vp-c-brand-1: $l-accent
  --vp-c-brand-2: lighten($l-accent, 8%)
  --vp-c-brand-3: $l-accent
  --vp-c-brand-soft: $l-accent-bg
  // Legacy aliases still read by some components
  --vp-c-brand: $l-accent
  --vp-c-brand-light: lighten($l-accent, 10%)
  --vp-c-brand-lighter: lighten($l-accent, 20%)
  --vp-c-brand-lightest: lighten($l-accent, 30%)
  --vp-c-brand-dark: darken($l-accent, 10%)
  --vp-c-brand-darker: darken($l-accent, 20%)
  --vp-c-brand-dimm: rgba(95, 69, 204, 0.08)

  // Buttons (light): gradient primary, tinted alt
  --vp-button-brand-bg: $l-accent
  --vp-button-brand-hover-bg: lighten($l-accent, 8%)
  --vp-button-brand-active-bg: darken($l-accent, 8%)
  --vp-button-brand-border: transparent
  --vp-button-brand-hover-border: transparent
  --vp-button-brand-active-border: transparent
  --vp-button-brand-text: #ffffff
  --vp-button-brand-hover-text: #ffffff
  --vp-button-brand-active-text: #ffffff

  --vp-button-alt-bg: rgba(95, 69, 204, 0.06)
  --vp-button-alt-hover-bg: rgba(95, 69, 204, 0.12)
  --vp-button-alt-active-bg: rgba(95, 69, 204, 0.16)
  --vp-button-alt-border: $l-brd
  --vp-button-alt-hover-border: rgba(95, 69, 204, 0.5)
  --vp-button-alt-active-border: rgba(95, 69, 204, 0.6)
  --vp-button-alt-text: $l-accent
  --vp-button-alt-hover-text: $l-accent
  --vp-button-alt-active-text: $l-accent
}

// === Royal (dark): the default appearance ===

.dark {
  --vp-c-bg: $bg
  --vp-c-bg-alt: $bg2
  --vp-c-bg-elv: $bg2
  --vp-c-bg-soft: $bg2
  --vp-c-gutter: #07060d

  --vp-c-text-1: $ink
  --vp-c-text-2: $muted
  --vp-c-text-3: $faint

  --vp-c-divider: $brd
  --vp-c-border: $brd

  --vp-c-brand-1: $accent
  --vp-c-brand-2: lighten($accent, 10%)
  --vp-c-brand-3: $accent
  --vp-c-brand-soft: rgba(232, 196, 104, 0.13)

  // Buttons (dark): primary = gold to violet gradient, dark text
  --vp-button-brand-bg: $accent
  --vp-button-brand-hover-bg: lighten($accent, 8%)
  --vp-button-brand-active-bg: darken($accent, 8%)
  --vp-button-brand-border: transparent
  --vp-button-brand-hover-border: transparent
  --vp-button-brand-active-border: transparent
  --vp-button-brand-text: $on-accent
  --vp-button-brand-hover-text: $on-accent
  --vp-button-brand-active-text: $on-accent

  --vp-button-alt-bg: rgba(243, 238, 251, 0.05)
  --vp-button-alt-hover-bg: rgba(243, 238, 251, 0.1)
  --vp-button-alt-active-bg: rgba(243, 238, 251, 0.12)
  --vp-button-alt-border: $brd
  --vp-button-alt-hover-border: rgba(232, 196, 104, 0.5)
  --vp-button-alt-active-border: rgba(232, 196, 104, 0.6)
  --vp-button-alt-text: $accent
  --vp-button-alt-hover-text: $accent
  --vp-button-alt-active-text: $accent
}

// Rounded corners for content images inserted via HTML (our converted images)

.vp-doc img[loading="lazy"][decoding="async"] {
  border-radius: 12px
}

/**
 * Dark/Light Theme Overrides
 * -------------------------------------------------------------------------- */

html:not(.dark) {
  .only-dark,
  img[data-mode="darkmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="darkmode-only"]) {
    display: none !important
  }
}

.dark {
  .only-light,
  img[data-mode="lightmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="lightmode-only"]) {
    display: none !important
  }
}

/**
 * Component: Home
 * -------------------------------------------------------------------------- */

:root {
  --vp-home-hero-name-color: transparent
  --vp-home-hero-name-background: -webkit-linear-gradient(120deg, $l-accent 30%, $l-grad-end)
  --vp-home-hero-image-background-image: linear-gradient(-45deg, $l-accent 50%, $l-grad-end 50%)
  --vp-home-hero-image-filter: blur(40px)
}

.dark {
  --vp-home-hero-name-background: -webkit-linear-gradient(120deg, $accent 30%, $accent2)
  --vp-home-hero-image-background-image: linear-gradient(-45deg, $accent 50%, $accent2 50%)
}

@media (min-width 640px) {
  :root {
    --vp-home-hero-image-filter: blur(56px)
  }
}

@media (min-width 960px) {
  :root {
    --vp-home-hero-image-filter: blur(72px)
  }
}

// Brand gradient buttons (theme --grad: 135deg). Dark uses gold to violet with
// dark text; light uses the Royal light gradient with white text.

:root {
  --tsumige-grad: linear-gradient(135deg, $l-accent, $l-grad-end)
}

.dark {
  --tsumige-grad: linear-gradient(135deg, $accent, $accent2)
}

.VPButton.brand {
  border: 0 !important
  color: var(--vp-button-brand-text) !important
  background: var(--tsumige-grad) !important
  transition: filter 0.25s ease, box-shadow 0.25s ease
}

.VPButton.brand:hover {
  filter: brightness(1.08)
  box-shadow: 0 4px 18px rgba(232, 196, 104, 0.35)
}

.dark .VPButton.brand {
  box-shadow: 0 0 22px -2px rgba(232, 196, 104, 0.35)
}

.VPFeature {
  background: $l-bg2 !important
  border: 1px solid $l-brd !important
}

.dark .VPFeature {
  background: $bg2 !important
  border: 1px solid $brd !important
}

.VPFeature .icon {
  background: $l-accent-bg !important
}

.dark .VPFeature .icon {
  background: #4a3f2d !important
}

.VPFooter {
  .divider {
    color: var(--vp-c-divider)
  }
}

/**
 * Component: Custom Block
 * -------------------------------------------------------------------------- */

:root {
  --vp-custom-block-tip-border: $l-accent
  --vp-custom-block-tip-text: darken($l-accent, 12%)
  --vp-custom-block-tip-bg: rgba(95, 69, 204, 0.08)

  --vp-custom-block-warning-border: #785a00
  --vp-custom-block-warning-text: #785a00
  --vp-custom-block-warning-bg: #fee6b6

  --vp-custom-block-danger-border: #ae2f34
  --vp-custom-block-danger-text: #ae2f34
  --vp-custom-block-danger-bg: #ffe1e0

  --vp-custom-block-info-border: #6745c7
  --vp-custom-block-info-text: #6745c7
  --vp-custom-block-info-bg: #ede4ff
}

.dark {
  --vp-custom-block-tip-border: $accent
  --vp-custom-block-tip-text: lighten($accent, 14%)
  --vp-custom-block-tip-bg: rgba(232, 196, 104, 0.12)

  --vp-custom-block-warning-border: $warning
  --vp-custom-block-warning-text: $warning
  --vp-custom-block-warning-bg: rgba(255, 207, 92, 0.12)

  --vp-custom-block-danger-border: $danger
  --vp-custom-block-danger-text: $danger
  --vp-custom-block-danger-bg: rgba(255, 107, 107, 0.12)

  --vp-custom-block-info-border: $accent2
  --vp-custom-block-info-text: $accent2
  --vp-custom-block-info-bg: rgba(155, 123, 255, 0.13)
}

.plugin-tabs {
  &--content {
    padding: 2rem !important
  }
}

/**
 * Component: Algolia
 * -------------------------------------------------------------------------- */

.DocSearch {
  --docsearch-primary-color: var(--vp-c-brand) !important
}

.VPImage.image-src {
  border-radius: 8px
}

/**
 * Component: LocalSearch
 */

.VPLocalSearchBox {
  --vp-local-search-highlight-bg: var(--vp-c-brand-soft)
  --vp-local-search-highlight-text: var(--vp-c-brand-dark)
}

.dark .VPLocalSearchBox {
  --vp-local-search-highlight-text: var(--vp-c-brand-lightest)
}

/**
 * Component: Image Figure
 * -------------------------------------------------------------------------- */

main figure {
  margin: 2rem 0
  transition: transform var(--vp-tt)

  img {
    margin: 0 auto
    border-radius: 12px
    box-shadow: 2px 2px 8px 4px var(--vp-c-bg-alt)

    &[alt="Translation progress"] {
      box-shadow: none !important
    }
  }

  figcaption {
    text-align: center
    margin-top: 1.25rem
    font-size: 0.875rem
    color: var(--vp-c-text-2)
  }

  & > a .external-link-icon {
    display: none
  }
}

main :where(h1, h2, h3, h4, h5, h6) + figure {
  margin-top: 1.5rem
}

.custom-block {
  figure figcaption {
    color: inherit
  }

  &.tip figure img {
    --vp-c-bg-alt: var(--vp-custom-block-tip-bg)
  }
}

/**
 * Component: Links
 * -------------------------------------------------------------------------- */

@media print {
  figure:has(img)>a[href^="http://"]:after,
  figure:has(img)>a[href^="https://"]:after {
    content: ""
  }
}

.vp-doc a {
  text-decoration: none

  &:hover {
    text-decoration: underline
    text-underline-offset: 2px
  }
}

/**
 * Component: Shortcodes
 * -------------------------------------------------------------------------- */

.navigation {
  color: var(--vp-c-green-2)
  font-weight: 600

  &:hover {
    color: var(--vp-c-green-1)
    cursor: default
  }

  svg,
  span.name {
    vertical-align: middle // Align both SVG and <span> vertically
    position: relative
    bottom: 1px
  }

  svg {
    fill: currentColor
    height: 1em
    width: 1em
    display: inline-block
    margin-right: 4px
  }
}

/**
 * Component: Element Plus
 */

body {
  --el-color-primary: var(--vp-c-brand-1)
}

/**
 * Component: Appearance Switch
 */

.menu + .appearance::before {
  margin-right: 8px !important
}

.appearance + .social-links::before {
  margin-left: 8px !important
}

.VPMenu .CustomSwitchAppearance {
  margin-right: -8px
}
